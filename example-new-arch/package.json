{
  "name": "react-native-map4d-map-example",
  "description": "Example app for react-native-map4d-map",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "node ./node_modules/react-native/cli.js run-android",
    "ios": "node ./node_modules/react-native/cli.js run-ios",
    "start": "node ./node_modules/react-native/cli.js start --port 8081",
    "build:android": "node ./node_modules/react-native/cli.js build-android --extra-params \"--no-daemon --console=plain -PreactNativeArchitectures=arm64-v8a\"",
    "build:ios": "node ./node_modules/react-native/cli.js build-ios --scheme Map4dMapExample --mode Debug --extra-params \"-sdk iphonesimulator CC=clang CPLUSPLUS=clang++ LD=clang LDPLUSPLUS=clang++ GCC_OPTIMIZATION_LEVEL=0 GCC_PRECOMPILE_PREFIX_HEADER=YES ASSETCATALOG_COMPILER_OPTIMIZATION=time DEBUG_INFORMATION_FORMAT=dwarf COMPILER_INDEX_STORE_ENABLE=NO\""
  },
  "dependencies": {
    "@react-navigation/native": "^7.1.18",
    "@react-navigation/native-stack": "^7.3.26",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.18.0"
  },
  "devDependencies": {
    "@react-native-community/cli": "20.0.2",
    "@react-native-community/cli-platform-android": "20.0.2",
    "@react-native-community/cli-platform-ios": "20.0.2",
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "react-native-builder-bob": "^0.40.5"
  }
}
